# Copy next to swapforcerecompiled.exe, rename to "swapforcerecomp.toml". Full docs in README.md.
# The in-game Settings overlay (F4) reads and writes this same file.

["Portal"]
portal_mode = "software"                  # "software", "usb" (real portal), or "none"
portal_figures_dir = ""                   # empty = "figures" next to your saves
# portal_figure = "C:\\path\\to\\Skylander.dump"  # loads this dump onto the portal at startup

["Graphics"]
resolution = "1920x1080"                  # startup window size
resolution_scale = 2                      # 1-8 supersample multiplier, 1 = off
frame_rate_limit = 60                     # 0 = unlimited
gpu_allow_invalid_fetch_constants = true  # works around a GPU quirk, on by default
render_target_path_d3d12 = "rov"           # accurate render target emulation; "rtv" is faster but renders characters black
# Not available yet: the ultrawide hook is still a Giants template (Phase 4).
# ultrawide_fov = true                      # widen camera FOV to match resolution's aspect ratio
# ultrawide_hud = true                      # lay out the HUD and menus for the real screen width
# vulkan_device = -1                      # GPU index for multi-GPU systems, -1 = auto-pick

["GPU"]
anisotropic_override = 5                  # texture filtering: 5 = 16x, 3 = 4x, 0 = off

["UI"]
# ui_scale = 1.5                          # ImGui overlay font/widget scale

["UI/Presenter"]
present_use_actual_aspect = true          # present the real rendered frame at 'resolution's real
                                           # aspect instead of the reported video mode's -- matters
                                           # together with ultrawide_fov above

["Input"]
mnk_mode = true                           # enable keyboard/mouse controller emulation

["Game"]
# language = "english"                   # english, french, german, spanish, italian (EU disc: english, german)
skip_intro = true                         # skip the Activision and Vicarious Visions logo movies
# skip_opening_movie = true                # skip the long opening movie of a new game

["Runtime"]
# user_data_root = "C:\\path\\to\\folder" # empty = Documents\swapforcerecomp
